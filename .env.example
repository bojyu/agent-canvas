# Copy this file to .env.local. Never commit the real key.
OPENROUTER_API_KEY=

# Image generation providers. Google accepts either variable name.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Comfly general key: Nano Banana, video, and every non-GPT-Image-2 model.
COMFLY_API_KEY=
# Optional dedicated key for prompt rewrite text models; falls back to COMFLY_API_KEY when empty.
COMFLY_LLM_API_KEY=
# COMFLY_LLM_DEFAULT_MODEL=gpt-5.6-terra
# Comfly GPT Image 2 uses strict per-resolution keys and never falls back to the general key.
COMFLY_GPT_IMAGE_2_1K_API_KEY=
COMFLY_GPT_IMAGE_2_2K_API_KEY=
COMFLY_GPT_IMAGE_2_4K_API_KEY=

# Optional video endpoints / local Seedance CLI executable.
# COMFLY_BASE_URL=https://ai.comfly.org
# DREAMINA_CLI_PATH=C:\Users\you\bin\dreamina.exe

# Optional: custom photoreal skill root or SKILL.md path.
# The current project also auto-detects ../真实感skill/photoreal_scene_model_skill/SKILL.md.
# PHOTOREAL_SKILL_PATH=D:\秋秋-木棉\项目\真实感skill

# Optional: choose the initial OpenRouter model shown by the canvas.
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4

# Optional advanced settings.
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:4173
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Antigravity CLI (agy) path. Required for Google AI Pro/Ultra after 2026-06-18.
# ANTIGRAVITY_CLI=C:\Users\you\.local\bin\agy.exe
# Only if you still use API-key Gemini CLI (subscription path is dead for Pro/Ultra):
# ALLOW_GEMINI_CLI_FALLBACK=1
# GEMINI_CLI=C:\Users\you\AppData\Roaming\npm\gemini.cmd
